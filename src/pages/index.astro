---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/global.css';
import GithubActivity from '../components/GithubActivity.astro';
---
<BaseLayout title="Robotics engineering portfolio" description="Adyaa Khera is a Purdue University Robotics Engineering Technology student building reliable robots across autonomy, space systems, and manipulation.">
  <section class="home-canvas" aria-label="Introduction">
    <div class="intro-card">
      <div class="intro-photo-frame">
        <img class="intro-photo" src="/media/main.jpeg" alt="Adyaa presenting a Fusion 360 robotics design" />
        <p class="intro-photo-caption">I want to make robots that go to space.</p>
      </div>
      <div class="intro-copy">
        <h1 class="typewriter" aria-label="Hi! I'm Adyaa Khera, a robotics engineer, a lifelong tinkerer, a teaching assistant, a photographer, and a traveller."><span id="typewriter-text">Hi! I’m Adyaa Khera.</span><span class="caret" aria-hidden="true"></span></h1>
        <p>Robotics at Purdue · Researcher at MARS Lab</p>
      </div>
    </div>
    <div class="home-lower">
      <div class="section-board">
        <div class="home-nav" aria-label="Explore the portfolio">
          <a class="nav-tile personal-tile" href="/projects/"><h2>Personal projects</h2><span aria-hidden="true">↗</span></a>
          <a class="nav-tile research-tile" href="/research/"><h2>Research</h2><span aria-hidden="true">↗</span></a>
          <div class="nav-tile about-tile" aria-label="About and journey photo carousel">
            <div class="dummy-carousel">
              <div class="carousel-track">
                <div class="carousel-slide"><img src="/media/main.jpeg" alt="Adyaa Khera pointing toward the camera" /><p class="carousel-caption">Behind the scenes.</p></div>
                <div class="carousel-slide"><img src="/media/contact.jpeg" alt="A behind-the-scenes view from Adyaa Khera's portfolio" /><p class="carousel-caption">A work in progress.</p></div>
                <div class="carousel-slide"><img src="/media/carousel/WhatsApp Image 2026-10-11 at 14.53.24.jpeg" alt="A robotics project in progress" /><p class="carousel-caption">Building something new.</p></div>
                <div class="carousel-slide"><img src="/media/carousel/WhatsApp Image 2026-10-11 at 14.55.35.jpeg" alt="A robotics workspace" /><p class="carousel-caption">In the lab.</p></div>
                <div class="carousel-slide"><img src="/media/carousel/WhatsApp Image 2026-10-11 at 14.58.06.jpeg" alt="A hands-on engineering moment" /><p class="carousel-caption">Hands-on engineering.</p></div>
              </div>
              <button class="carousel-arrow carousel-prev" type="button" aria-label="Previous About and journey image">←</button>
              <button class="carousel-arrow carousel-next" type="button" aria-label="Next About and journey image">→</button>
            </div>
          </div>
          <a class="nav-tile contact-tile" href="mailto:adyaa.khera@gmail.com"><h2>Contact me</h2><span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <GithubActivity />
    </div>
  </section>
</BaseLayout>
<script>
  const typewriter = document.querySelector('#typewriter-text');
  const phrases = [
    'Hi! I’m Adyaa Khera.',
    'Hi! I’m a robotics engineer.',
    'Hi! I’m a lifelong tinkerer.',
    'Hi! I’m a teaching assistant.',
    'Hi! I’m a photographer.',
    'Hi! I’m a traveller.'
  ];
  let phraseIndex = 0;
  let characterIndex = phrases[0].length;
  let deleting = true;
  const sharedPrefixLength = (from: string, to: string) => {
    let index = 0;
    while (index < from.length && index < to.length && from[index] === to[index]) index += 1;
    return index;
  };
  const pause = (duration: number) => new Promise<void>((resolve) => window.setTimeout(resolve, duration));
  const animateType = async () => {
    if (!typewriter) return;
    const current = phrases[phraseIndex];
    const next = phrases[(phraseIndex + 1) % phrases.length];
    if (deleting) {
      characterIndex = Math.max(sharedPrefixLength(current, next), characterIndex - 1);
      typewriter.textContent = current.slice(0, characterIndex);
      if (characterIndex === sharedPrefixLength(current, next)) {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        await pause(420);
      } else {
        await pause(42);
      }
    } else {
      const target = phrases[phraseIndex];
      characterIndex = Math.min(target.length, characterIndex + 1);
      typewriter.textContent = target.slice(0, characterIndex);
      if (characterIndex === target.length) {
        deleting = true;
        await pause(1800);
      } else {
        await pause(78);
      }
    }
    window.requestAnimationFrame(animateType);
  };
  pause(1800).then(() => window.requestAnimationFrame(animateType));

  const carousel = document.querySelector('.dummy-carousel');
  const track = carousel?.querySelector('.carousel-track') as HTMLElement | null;
  const slides = track ? Array.from(track.querySelectorAll('img')) : [];
  if (track) track.style.setProperty('--slide-count', String(slides.length));
  let slideIndex = 0;
  let carouselTimer: number | undefined;
  const showSlide = (index: number) => {
    if (!track || slides.length === 0) return;
    slideIndex = (index + slides.length) % slides.length;
    track.style.transform = `translateX(-${slideIndex * (100 / slides.length)}%)`;
  };
  const resetCarouselTimer = () => {
    if (carouselTimer) window.clearInterval(carouselTimer);
    carouselTimer = window.setInterval(() => showSlide(slideIndex + 1), 3000);
  };
  carousel?.querySelector('.carousel-prev')?.addEventListener('click', () => {
    showSlide(slideIndex - 1);
    resetCarouselTimer();
  });
  carousel?.querySelector('.carousel-next')?.addEventListener('click', () => {
    showSlide(slideIndex + 1);
    resetCarouselTimer();
  });
  showSlide(0);
  resetCarouselTimer();
</script>
