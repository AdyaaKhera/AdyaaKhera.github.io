---
interface Props {
  title: string;
  description: string;
  image?: string;
}
const { title, description, image = '/og-default.svg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Adyaa Khera</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} — Adyaa Khera`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script type="module" src="https://unpkg.com/@google/model-viewer@4.0.0/dist/model-viewer.min.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/"><span class="mark">AK</span><span>ADYAA KHERA</span></a>
      <nav aria-label="Primary navigation">
        <a href="/projects/">Projects</a>
        <a href="/research/">Research</a>
      </nav>
      <a class="header-contact" href="mailto:adyaa.khera@gmail.com"><span class="status-dot"></span>Available for conversations</a>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Adyaa Khera</span>
      <span>Robotics engineering technology · Purdue University</span>
      <a href="https://github.com/AdyaaKhera" rel="me">GitHub ↗</a>
    </footer>
  </body>
</html>
<style is:global>
  :root { --ink:#1f1a2e; --muted:#706b7c; --line:#d9d4df; --paper:#f7f4ee; --panel:#e4e0f4; --accent:#a6c96a; --violet:#c8c1ee; --max:1280px; }
  * { box-sizing:border-box; }
  html { background:var(--paper); color:var(--ink); font-family:Manrope, sans-serif; }
  body { margin:0; min-width:320px; }
  a { color:inherit; text-decoration:none; }
  a:hover { color:var(--accent); }
  .skip-link { position:absolute; left:1rem; top:-5rem; background:var(--ink); color:white; padding:.7rem 1rem; z-index:10; }
  .skip-link:focus { top:1rem; }
  .site-header, .site-footer { width:min(calc(100% - 3.5rem), var(--max)); margin:auto; display:flex; align-items:center; }
  .site-header { min-height:78px; justify-content:space-between; gap:2rem; }
  .wordmark { display:flex; align-items:center; gap:.7rem; font:600 .72rem/1 DM Mono, monospace; letter-spacing:.08em; }
  .mark { display:grid; place-items:center; width:30px; height:30px; border:1px solid var(--ink); border-radius:50%; font-size:.65rem; }
  nav { display:flex; gap:.4rem; padding:.3rem; border:1px solid var(--line); border-radius:999px; font-size:.72rem; }
  nav a { color:var(--muted); padding:.55rem .9rem; border-radius:999px; }
  nav a:hover, nav a[aria-current="page"] { color:var(--ink); background:var(--panel); }
  .header-contact { display:flex; align-items:center; gap:.55rem; color:var(--muted); font:500 .65rem DM Mono, monospace; }
  .status-dot { width:7px; height:7px; background:var(--accent); border-radius:50%; }
  .site-footer { border-top:1px solid var(--line); padding:1rem 0 1.3rem; justify-content:space-between; color:var(--muted); font: .62rem DM Mono, monospace; gap:1rem; }
  @media (max-width:700px) { .site-header, .site-footer { width:min(calc(100% - 2rem), var(--max)); } .site-header { flex-wrap:wrap; padding:1rem 0; } nav { order:3; width:100%; justify-content:center; } .header-contact { margin-left:auto; } .site-footer { align-items:flex-start; flex-direction:column; } }
</style>
